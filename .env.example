# Copie para .env.local e ajuste os valores. Nunca commite segredos reais.

# Base URL do backend/proxy seguro. Espera GET /products e GET /products/:id.
# O frontend nunca deve receber chaves de marketplaces ou provedores de trends.
# Sem esta variável, o PWA usa o catálogo mock/offline.
VITE_API_BASE_URL=

# ID de analytics opcional (ex.: Plausible, GA4)
VITE_ANALYTICS_ID=
